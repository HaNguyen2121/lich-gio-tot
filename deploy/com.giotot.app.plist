<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.giotot.app</string>

    <!-- Chạy trong vòng lặp bash để tự thử lại nếu python crash tạm thời
         (vd EDEADLK lúc máy khởi động lại / nâng cấp macOS). Bản thật do
         deploy/install-service.sh sinh ra với đường dẫn của từng máy. -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-c</string>
        <string>cd '/Users/hanguyen/Documents/Personal/Applications/Gio-tot-Dich-ly'; while true; do '/Users/hanguyen/miniconda3/bin/python3' -m giotot --no-open --port 5057; sleep 3; done</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/hanguyen/Documents/Personal/Applications/Gio-tot-Dich-ly</string>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/hanguyen/Library/Logs/giotot.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/hanguyen/Library/Logs/giotot.log</string>
</dict>
</plist>
